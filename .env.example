# Server
PORT=4000
NODE_ENV=development

# Postgres — lokal uchun namuna.
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova?schema=public"

# Faqat serverless Postgres (Neon, Supabase) uchun: migration'lar pooler ustida
# ishlamaydi, shuning uchun to'g'ridan-to'g'ri manzil kerak. Lokalda bo'sh qoldiring.
#   DATABASE_URL → "-pooler" li manzil (ilova)
#   DIRECT_URL   → "-pooler" siz manzil (migration)
DIRECT_URL=

# Firebase Auth — faqat loyiha identifikatori. Maxfiy kalit emas, service account JSON kerak emas:
# ID token Google'ning ommaviy JWKS kalitlari bilan tekshiriladi.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Frontend manzillari (CORS). Vergul bilan ajratiladi, bo'sh joysiz.
# Production: CORS_ORIGINS=https://sizning-sayt.netlify.app
CORS_ORIGINS=http://localhost:3000

# Firebase Web API key (maxfiy emas) — scripts/get-token.ts uchun
FIREBASE_API_KEY=
